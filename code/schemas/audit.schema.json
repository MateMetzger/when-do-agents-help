{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alignment audit v1",
  "type": "object", "additionalProperties": false,
  "required": ["task_id", "candidate_sha256", "round", "verdict", "issues", "summary"],
  "properties": {
    "task_id": {"type": "string"},
    "candidate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "round": {"type": "integer", "minimum": 1, "maximum": 5},
    "verdict": {"enum": ["clear", "revise"]},
    "summary": {"type": "string"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "source_ids", "english_ids", "description", "requested_change"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["structure", "correspondence", "unmatched_material", "unsupported_certainty"]},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "english_ids": {"type": "array", "items": {"type": "string"}},
          "description": {"type": "string", "minLength": 1},
          "requested_change": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
