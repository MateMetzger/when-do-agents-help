{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alignment result v1",
  "type": "object", "additionalProperties": false,
  "required": ["task_id", "english_units", "source_alignments"],
  "properties": {
    "task_id": {"type": "string"},
    "english_units": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "text", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "status": {"enum": ["aligned", "no_counterpart", "unresolved"]},
          "note": {"type": "string"}
        }
      }
    },
    "source_alignments": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_ids", "english_ids", "status"],
        "properties": {
          "source_ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
          "english_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "status": {"enum": ["matched", "no_counterpart", "unresolved", "empty_source"]},
          "note": {"type": "string"}
        }
      }
    }
  }
}
